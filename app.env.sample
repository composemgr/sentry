# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=sentry.example.com

DB_CREATE_DATABASE_NAME=sentry
DB_USER_NAME=sentry
DB_USER_PASS=replace-with-a-random-password

# Secret used to sign session cookies and tokens, keep it to 32 characters or
# longer, changing it invalidates every login
APP_SECRET_KEY=replace-with-a-random-secret-min-32-chars

# Outbound mail server, Sentry sends password resets and alert notifications
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=25
EMAIL_SERVER_LOGIN_NAME=
EMAIL_SERVER_LOGIN_PASS=
EMAIL_SERVER_USE_TLS=false
EMAIL_SERVER_MAIL_FROM=noreply@example.com
